# Copy to .env and fill in the keys you use. .env is gitignored.

# --- Dynamic Search Kit -----------------------------------------------------
# combined = one dynamic_search tool; separate = one tool per provider;
# both = expose the combined and separate tools.
DYNAMIC_SEARCH_TOOL_MODE=combined

# Enabled providers and fallback order. Any subset of:
# searxng,tavily,tinyfish,camoufox
DYNAMIC_SEARCH_PROVIDERS=searxng,tavily,tinyfish,camoufox

# first = stop at the first provider with results;
# merge = query all providers and deduplicate URLs.
DYNAMIC_SEARCH_STRATEGY=first

# fetch_url defaults: the model picks the pages; this controls each fetch.
DYNAMIC_SEARCH_FETCH_MAX_CHARS=20000
# auto = static HTTP first, Camoufox only for JS/shell/challenge pages;
# always = Camoufox for every page; never = static HTTP only.
DYNAMIC_SEARCH_FETCH_RENDER=auto
DYNAMIC_SEARCH_FETCH_MIN_CHARS=300

# --- SearXNG ----------------------------------------------------------------
SEARXNG_MCP_BASE_URL=http://127.0.0.1:8888
SEARXNG_MCP_TIMEOUT=15
SEARXNG_MCP_USER_AGENT=custom-agent-mcp/0.2 (SearXNG client)
# Optional launcher; enables the start_searxng tool.
# SEARXNG_MCP_START_CMD=C:\Users\you\Apps\searxng-windows\start-searxng.cmd
SEARXNG_MCP_START_TIMEOUT=90

# --- Tavily -----------------------------------------------------------------
# Get a key at https://app.tavily.com.
TAVILY_API_KEY=
TAVILY_MCP_BASE_URL=https://api.tavily.com
TAVILY_MCP_TIMEOUT=15
TAVILY_MCP_SEARCH_DEPTH=basic
TAVILY_MCP_INCLUDE_ANSWER=false
TAVILY_MCP_INCLUDE_RAW_CONTENT=false

# --- TinyFish ---------------------------------------------------------------
# Get a key at https://tinyfish.ai. TinyFish is a normal provider; remove it
# from DYNAMIC_SEARCH_PROVIDERS if you do not want it in the chain.
TINYFISH_API_KEY=
TINYFISH_MCP_BASE_URL=https://api.search.tinyfish.ai
TINYFISH_MCP_TIMEOUT=15

# --- Camoufox ---------------------------------------------------------------
# local runs on this PC; remote connects to a Playwright websocket server.
CAMOUFOX_MCP_MODE=local
# CAMOUFOX_MCP_REMOTE_URL=ws://127.0.0.1:9222/dynamic-search
CAMOUFOX_MCP_HEADLESS=true
CAMOUFOX_MCP_HUMANIZE=true
# CAMOUFOX_MCP_PROFILE_DIR=C:\Users\you\AppData\Local\dynamic-search-kit\camoufox
CAMOUFOX_MCP_LOCALE=en-US
CAMOUFOX_MCP_OS=windows
# CAMOUFOX_MCP_PROXY=http://user:pass@host:8080
CAMOUFOX_MCP_GEOIP=false
CAMOUFOX_MCP_TIMEOUT=45
CAMOUFOX_MCP_SETTLE_MS=750
CAMOUFOX_MCP_SEARCH_ENGINE=duckduckgo
# CAMOUFOX_MCP_SEARCH_URL=https://search.example/?q={query}
CAMOUFOX_MCP_SEARCH_SESSION=search
# Separate session used by fetch_url, so it does not navigate away from your
# manually browsed page.
CAMOUFOX_MCP_FETCH_SESSION=fetch