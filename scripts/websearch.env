# Environment for the shared Dynamic Search Kit server on 127.0.0.1:8765.
#
# These values used to live in the "websearch" MCP entry of
# ~/.config/opencode/opencode.jsonc. A single shared server reads them once at
# startup instead of once per project directory.
#
# Used by scripts/ensure_websearch_server.py (--env-file); change and restart:
#   python scripts/ensure_websearch_server.py --restart

SEARXNG_MCP_BASE_URL=http://127.0.0.1:8888
SEARXNG_MCP_START_CMD=C:\Users\amade\Apps\searxng-windows\start-searxng.cmd
SEARXNG_MCP_START_TIMEOUT=90

# remote = attach to a camofox-browser daemon; local = launch Camoufox here.
CAMOUFOX_MCP_MODE=remote
CAMOUFOX_MCP_REMOTE_URL=ws://192.168.1.194:9222/dynamic-search
CAMOUFOX_MCP_SERVER_USER=default
CAMOUFOX_MCP_SERVER_SESSION_PREFIX=dsk

# Seconds a tool call waits for its turn on a browser session before failing
# with a "session busy" error. 0 blocks forever.
CAMOUFOX_MCP_QUEUE_TIMEOUT=300